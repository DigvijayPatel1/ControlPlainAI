{
    "manifest_version": 3,
    "name": "ControlPlane AI",
    "version": "1.1.0",
    "description": "AI safety, cost, and observability controls for your chat sessions.",
    "permissions": ["storage", "tabs", "scripting"],
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
    ],
    "optional_host_permissions": [
        "https://*/*"
    ],
    "externally_connectable": {
        "matches": [
            "http://localhost:5173/*",
            "http://127.0.0.1:5173/*"
        ]
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*"
            ],
            "js": ["content-main.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "ControlPlane AI",
        "default_popup": "index.html"
    }
}