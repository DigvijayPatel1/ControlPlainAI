APP_NAME=ControlPlane API
APP_ENV=development
DEBUG=True

# ==================================================
# Database
# ==================================================

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/controlplane

# ==================================================
# OpenAI (server-side secret only)
# ==================================================
# Keep this on the backend. Never expose it to the browser or frontend dashboard.
# Prefer environment variables or a secret manager in production.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_COMPLETION_TOKENS=1000

# ==================================================
# Redis
# ==================================================

REDIS_URL=

# ==================================================
# Auth / JWT
# ==================================================
# JWT secret is also server-side only; store it in a secure secret manager in production.

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_MONTHLY_BUDGET_USD=25.0

# ==================================================
# CORS
# ==================================================

FRONTEND_ORIGIN=http://localhost:5173